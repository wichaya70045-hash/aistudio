# ==============================================================================
# AI Reels Studio - Configuration
# ==============================================================================

# ใส่ Gemini API Key ของคุณที่นี่ (รับฟรีได้จาก https://aistudio.google.com/)
GEMINI_API_KEY=

# เสียงพากย์เริ่มต้น (Edge-TTS ฟรี 100% ไม่ต้องใช้ API Key):
# - th-TH-NiwatNeural (ชาย เสียงเข้ม หนักแน่น เหมาะกับเรื่องลึกลับ/ผี/ประวัติศาสตร์)
# - th-TH-PremwadeeNeural (หญิง นุ่มนวล ชัดเจน เหมาะกับดราม่า/เล่าเรื่องทั่วไป)
DEFAULT_VOICE=th-TH-NiwatNeural

# สไตล์เริ่มต้น (horror, mystery, drama, motivation, history)
DEFAULT_STYLE=horror

# (ตัวเลือกเสริม) ElevenLabs API Key หากต้องการใช้เสียงพากย์พรีเมียม
ELEVENLABS_API_KEY=
